# Copiar a .env en el servidor (nunca subir .env al repo) y completar.
# Clave que el cliente envía en la cabecera X-API-Key.
# Mínimo 16 caracteres: letras, números, . _ ~ -
# Generar una con:  openssl rand -hex 24
API_KEY=

# Peticiones por IP a /api/... (formato 10r/s o 600r/m). Opcional, por defecto 10r/s.
# Para la prueba de carga con Locust se puede subir temporalmente (ej. 200r/s).
RATE_LIMIT=10r/s
